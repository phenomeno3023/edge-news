# Copy to .env.nxt.local, set local file permissions to owner-only, and fill secrets there.
EDGE_NXT_ENABLED=false
EDGE_NXT_KIS_APP_KEY=
EDGE_NXT_KIS_APP_SECRET=
EDGE_NXT_DB_PATH=./data/edge-nxt-market.sqlite
EDGE_NXT_UNIVERSE_PATH=./data/nxt-universe.json
# Optional:
# EDGE_NXT_KIS_BASE_URL=https://openapi.koreainvestment.com:9443
# EDGE_NXT_KIS_WS_URL=ws://ops.koreainvestment.com:21000
